      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="UAE — architecture proposée et modèle CloudSim Plus&#xa;Population et répartition : hypothèses à valider" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="280" y="30" width="1040" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="users" value="Utilisateurs potentiels UAE&#xa;130 750 étudiants + 1 357 enseignants + 598 personnels&#xa;N = 132 705&#xa;Normal : 5 % (~6 635) | Pointe : 30 % (~39 812)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="490" y="130" width="620" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="lb" value="DNS / répartiteur de charge&#xa;55 % Ouest / 45 % Est (hypothèse)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="590" y="300" width="420" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="west" value="DATACENTER OUEST — TANGER&#xa;8 hôtes | 16 PE × 10 000 MIPS / hôte&#xa;65 536 MiB RAM | 1 000 000 MB stockage&#xa;6 VM initiales, 4 vCPU / 8 GiB / 50 GB&#xa;Broker et workload dédiés au site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="470" width="560" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="east" value="DATACENTER EST — TÉTOUAN&#xa;6 hôtes | 16 PE × 10 000 MIPS / hôte&#xa;65 536 MiB RAM | 1 000 000 MB stockage&#xa;4 VM initiales, 4 vCPU / 8 GiB / 50 GB&#xa;Broker et workload dédiés au site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="920" y="470" width="560" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="autoscale" value="HorizontalVmScalingSimple&#xa;Déclenchement : CPU VM ≥ 70 %&#xa;Jusqu'à 20 VM au total&#xa;Nouvelles VM sur le site surchargé" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
