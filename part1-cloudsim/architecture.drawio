        <mxCell id="e7" value="Charge synthétique du benchmark" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="workload" target="east"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="850"/></Array></mxGeometry></mxCell>
        <mxCell id="note" value="La simulation représente deux datacenters privés logiques. Le cloud public, la latence réseau et le trafic réel ne sont pas simulés. Les 50/300 Cloudlets sont des échantillons, pas des requêtes/s." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
